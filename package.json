{
  "name": "butus-root",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "mock-target": "node scripts/mock-target.mjs",
    "mock-webhook": "node scripts/mock-webhook.mjs",
    "check:once": "tsx packages/checker/src/index.ts",
    "seed": "node scripts/seed-data.mjs",
    "schema:gen": "tsx packages/schema/scripts/generate.ts",
    "validate:config": "tsx scripts/validate-config.ts",
    "validate:api": "tsx scripts/validate-api.ts",
    "build": "npm run build -w site",
    "preview": "npm run preview -w site",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run check -w site"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  }
}
