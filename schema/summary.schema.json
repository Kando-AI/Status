{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "windowDays": {
      "type": "number",
      "const": 30
    },
    "monitors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "uptimePct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "days": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "up": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "degraded": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "down_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "down_minutes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "avg_ms": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "max_ms": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "color": {
                  "type": "string",
                  "enum": [
                    "green",
                    "yellow",
                    "red",
                    "blue",
                    "gray"
                  ]
                }
              },
              "required": [
                "date",
                "total",
                "up",
                "degraded",
                "down_count",
                "down_minutes",
                "avg_ms",
                "max_ms",
                "color"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "group",
          "uptimePct",
          "days"
        ]
      }
    }
  },
  "required": [
    "version",
    "generatedAt",
    "windowDays",
    "monitors"
  ]
}
