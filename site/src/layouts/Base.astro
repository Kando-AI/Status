---
import '../styles/global.css'
import type { Strings } from '../lib/i18n'
interface Props {
  title: string
  description?: string
  siteTitle: string
  repoUrl: string | null
  rawStatusUrl: string | null
  s: Strings
  logo?: string | null
}
const { title, description, siteTitle, repoUrl, rawStatusUrl, s, logo = null } = Astro.props
const base = import.meta.env.BASE_URL
---

<!doctype html>
<html lang={s.locale} data-raw-status={rawStatusUrl}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" type="application/atom+xml" title={`${siteTitle} — ${s.feedIncidents}`} href={`${base}feed.xml`} />
    <link rel="icon" href={logo ?? `data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><circle cx='8' cy='8' r='6' fill='%2327a56a'/></svg>`} />
    <script is:inline>
      // 主题唯一权威源:data-theme;默认跟随系统,切换持久化(THEME-003)
      const saved = localStorage.getItem('theme')
      const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
      if (dark) document.documentElement.dataset.theme = 'dark'
    </script>
  </head>
  <body class="bg-page text-ink">
    <div class="mx-auto w-full max-w-3xl px-4 sm:px-6">
      <header class="flex items-center justify-between gap-4 py-6">
        <a href={base} class="flex min-w-0 items-center gap-2.5 no-underline">
          {
            logo ? (
              <img src={logo} alt="" class="h-5 w-auto" />
            ) : (
              <span class="status-dot" style="background: var(--t-ok)" aria-hidden="true" />
            )
          }
          <span class="truncate text-[0.9375rem] font-semibold tracking-tight">{siteTitle}</span>
        </a>
        <nav class="flex items-center gap-1 text-[0.8125rem]" aria-label="Site">
          <a href={`${base}history/`} class="rounded-md px-2.5 py-1.5 text-muted hover:bg-surface-2 hover:text-ink">{s.navHistory}</a>
          <a href={`${base}feed.xml`} class="rounded-md px-2.5 py-1.5 text-muted hover:bg-surface-2 hover:text-ink">RSS</a>
          {repoUrl && (
            <a href={repoUrl} class="rounded-md px-2.5 py-1.5 text-muted hover:bg-surface-2 hover:text-ink" rel="noopener">GitHub</a>
          )}
          <button
            id="theme-toggle"
            type="button"
            class="ml-1 grid size-8 place-items-center rounded-md text-muted hover:bg-surface-2 hover:text-ink"
            aria-label={s.themeToggle}
          >
            <svg class="size-4 [html[data-theme=dark]_&]:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <svg class="hidden size-4 [html[data-theme=dark]_&]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" stroke-linecap="round"/></svg>
          </button>
        </nav>
      </header>
      <main class="pb-16">
        <slot />
      </main>
      <footer class="flex flex-wrap items-center justify-between gap-2 border-t border-line py-6 text-[0.75rem] text-faint">
        <span>{s.poweredPrefix}<a href="https://github.com/Bearisbug/Butus" class="underline hover:text-muted">Butus</a>{s.poweredSuffix}</span>
        <slot name="footer-extra" />
      </footer>
    </div>
    <script>
      // 主题切换(权威源同 head 内联脚本)
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
        if (next === 'dark') root.dataset.theme = 'dark'
        else delete root.dataset.theme
        localStorage.setItem('theme', next)
      })
      // <time data-local> 转访客本地时区
      for (const el of document.querySelectorAll('time[data-local]')) {
        const iso = el.getAttribute('datetime')
        if (!iso) continue
        const d = new Date(iso)
        el.textContent = d.toLocaleString(undefined, {
          month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit',
        })
        el.setAttribute('title', d.toISOString())
      }
    </script>
  </body>
</html>
